+/**
+ * Exclusive copy fallback for platforms whose filesystems refuse hard links.
+ *
+ * Android's app data partition rejects cross-directory hard linking, which makes the
+ * POSIX publication path fail with EACCES even though nothing is wrong with the
+ * session. COPYFILE_EXCL preserves the exact guarantee that path needs: create the
+ * destination only if it does not already exist. An existing destination still
+ * rejects with EEXIST, so the caller's conflict branch is unchanged.
+ */
+async function copyFileExclusive(existingPath: string, newPath: string): Promise<void> {
+  await fsCopyFile(existingPath, newPath, fsConstants.COPYFILE_EXCL)
+}
